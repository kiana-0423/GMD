# Same splitting and same real-space cutoff as every PME run in this case, but
# the reciprocal sum is evaluated exactly by explicit k-vector summation rather
# than on a mesh. kmax 24 puts exp(-k^2/4 alpha^2) below 1e-20 on every axis, so
# this is the exact limit that all the mesh methods approximate.
velocity 0.0
time_step 1.0
run 1
output_interval 1
velocity_init input
remove_com_velocity false

coulomb ewald
ewald_alpha 0.35
ewald_kmax 24
ewald_cutoff 8.0
